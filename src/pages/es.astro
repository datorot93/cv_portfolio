---
import Layout from "../layouts/Layout.astro";
import cvData from '../data/cv.es.json';

import Section from '../components/Section.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import Mail from '../icons/Mail.astro';
import Phone from '../icons/Phone.astro';
import GitHub from '../icons/GitHub.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import WorldMap from '../icons/WorldMap.astro';

// Import shared styles
import '../styles/shared.css';

const { basics, work, education, skills } = cvData;

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn
};

// Format dates in Spanish
function formatDate(dateString: string | null): string {
  if (!dateString) return 'Actual';
  const date = new Date(dateString);
  const month = date.toLocaleDateString('es-ES', { month: 'long' });
  const year = date.getFullYear();
  return `${month}/${year}`;
}
---

<Layout title={`${basics.name} - ${basics.label}`}>
  <html lang="es">
  <LanguageToggle />
  <main>
    <!-- Hero Section -->
    <Section>
      <div class="hero-container">
        <div class="hero-info">
          <h1>{basics.name}</h1>
          <h2>{basics.label}</h2>
          <span class="location">
            <WorldMap />
            {basics.location.city}, {basics.location.region}
          </span>
          <footer class="contact-links">
            {basics.email && (
              <a
                href={`mailto:${basics.email}`}
                title={`Enviar correo a ${basics.name} al correo ${basics.email}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-item"
              >
                <Mail />
                <span class="contact-text">{basics.email}</span>
              </a>
            )}
            {basics.phone && (
              <a
                href={`tel:${basics.phone}`}
                title={`Llamar a ${basics.name} al número ${basics.phone}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-item"
              >
                <Phone />
                <span class="contact-text">{basics.phone}</span>
              </a>
            )}
            {basics.profiles.map(({ network, url, username }) => {
              const Icon = SOCIAL_ICONS[network];
              return (
                <a
                  href={url}
                  title={`Visitar el perfil de ${network} de ${basics.name}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-item"
                >
                  <Icon />
                  <span class="contact-text">{network}: {username || url}</span>
                </a>
              );
            })}
          </footer>
        </div>
        <figure class="hero-image">
          <img src={basics.image} alt={basics.name} />
        </figure>
      </div>
    </Section>

    <!-- About Section -->
    {basics.summary && (
      <Section title="Acerca de">
        <p>{basics.summary}</p>
      </Section>
    )}

    <!-- Experience Section -->
    {work && work.length > 0 && (
      <Section title="Experiencia Laboral">
        <ul class="timeline-list">
          {work.map(({ name, position, url, startDate, endDate, summary }) => (
            <li>
              <article class="experience-item">
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{position}</h4>
                  </div>
                  <div class="date-range">
                    <time datetime={startDate}>
                      {formatDate(startDate)}
                    </time>
                    {' - '}
                    <time datetime={endDate || ''}>
                      {endDate ? formatDate(endDate) : 'Actual'}
                    </time>
                    <button class="expand-toggle" aria-expanded="false" type="button">
                      <span class="sr-only">Mostrar descripción</span>
                      <span class="arrow" aria-hidden="true">▼</span>
                    </button>
                  </div>
                </header>

                <div class="description" data-collapsed="true">
                  <p>{summary}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Education Section -->
    {education && education.length > 0 && (
      <Section title="Educación">
        <ul class="timeline-list">
          {education.map(({ institution, url, startDate, endDate, area, studyType }) => (
            <li>
              <article>
                <header>
                  <div>
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        <h3>{institution}</h3>
                      </a>
                    ) : (
                      <h3>{institution}</h3>
                    )}
                    <h4>{studyType}</h4>
                    <p>{area}{endDate === null && ' (En Curso)'}</p>
                  </div>
                  <div class="date-range">
                    <time datetime={startDate}>
                      {formatDate(startDate)}
                    </time>
                    {' - '}
                    <time datetime={endDate || ''}>
                      {endDate ? formatDate(endDate) : 'Actual'}
                    </time>
                  </div>
                </header>
              </article>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Skills Section -->
    {skills && skills.length > 0 && (
      <Section title="Habilidades">
        <ul class="skills-list">
          {skills.map(({ name, keywords }) => (
            <li class="skill-category">
              <h3>{name}</h3>
              <div class="keywords">
                {keywords.map((keyword) => (
                  <span class="keyword">{keyword}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )}
  </main>
</Layout>

</Layout>

<script src="../scripts/collapsible.js"></script>
