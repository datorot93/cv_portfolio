---
import Layout from "../layouts/Layout.astro";
import cvData from '../data/cv.es.json';

import Section from '../components/Section.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import Mail from '../icons/Mail.astro';
import Phone from '../icons/Phone.astro';
import GitHub from '../icons/GitHub.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import WorldMap from '../icons/WorldMap.astro';

const { basics, work, education, skills } = cvData;

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn
};

// Format dates in Spanish
function formatDate(dateString: string | null): string {
  if (!dateString) return 'Actual';
  const date = new Date(dateString);
  const month = date.toLocaleDateString('es-ES', { month: 'long' });
  const year = date.getFullYear();
  return `${month}/${year}`;
}
---

<Layout title={`${basics.name} - ${basics.label}`}>
  <LanguageToggle />
  <main>
    <!-- Hero Section -->
    <Section>
      <div class="hero-container">
        <div class="hero-info">
          <h1>{basics.name}</h1>
          <h2>{basics.label}</h2>
          <span class="location">
            <WorldMap />
            {basics.location.city}, {basics.location.region}
          </span>
          <footer class="contact-links">
            {basics.email && (
              <a
                href={`mailto:${basics.email}`}
                title={`Enviar correo a ${basics.name} al correo ${basics.email}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-item"
              >
                <Mail />
                <span class="contact-text">{basics.email}</span>
              </a>
            )}
            {basics.phone && (
              <a
                href={`tel:${basics.phone}`}
                title={`Llamar a ${basics.name} al número ${basics.phone}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-item"
              >
                <Phone />
                <span class="contact-text">{basics.phone}</span>
              </a>
            )}
            {basics.profiles.map(({ network, url, username }) => {
              const Icon = SOCIAL_ICONS[network];
              return (
                <a
                  href={url}
                  title={`Visitar el perfil de ${network} de ${basics.name}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-item"
                >
                  <Icon />
                  <span class="contact-text">{network}: {username || url}</span>
                </a>
              );
            })}
          </footer>
        </div>
        <figure class="hero-image">
          <img src={basics.image} alt={basics.name} />
        </figure>
      </div>
    </Section>

    <!-- About Section -->
    {basics.summary && (
      <Section title="Acerca de">
        <p>{basics.summary}</p>
      </Section>
    )}

    <!-- Experience Section -->
    {work && work.length > 0 && (
      <Section title="Experiencia Laboral">
        <ul class="timeline-list">
          {work.map(({ name, position, url, startDate, endDate, summary }) => (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{position}</h4>
                  </div>
                  <div class="date-range">
                    <time datetime={startDate}>
                      {formatDate(startDate)}
                    </time>
                    {' - '}
                    <time datetime={endDate || ''}>
                      {endDate ? formatDate(endDate) : 'Actual'}
                    </time>
                  </div>
                </header>
                <footer>
                  <p>{summary}</p>
                </footer>
              </article>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Education Section -->
    {education && education.length > 0 && (
      <Section title="Educación">
        <ul class="timeline-list">
          {education.map(({ institution, url, startDate, endDate, area, studyType }) => (
            <li>
              <article>
                <header>
                  <div>
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        <h3>{institution}</h3>
                      </a>
                    ) : (
                      <h3>{institution}</h3>
                    )}
                    <h4>{studyType}</h4>
                    <p>{area}{endDate === null && ' (En Curso)'}</p>
                  </div>
                  <div class="date-range">
                    <time datetime={startDate}>
                      {formatDate(startDate)}
                    </time>
                    {' - '}
                    <time datetime={endDate || ''}>
                      {endDate ? formatDate(endDate) : 'Actual'}
                    </time>
                  </div>
                </header>
              </article>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Skills Section -->
    {skills && skills.length > 0 && (
      <Section title="Habilidades">
        <ul class="skills-list">
          {skills.map(({ name, keywords }) => (
            <li class="skill-category">
              <h3>{name}</h3>
              <div class="keywords">
                {keywords.map((keyword) => (
                  <span class="keyword">{keyword}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )}
  </main>
</Layout>

<style>
  /* Use the same styles as index.astro */
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  /* Hero styles */
  .hero-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  .hero-info h1 {
    font-size: 2rem;
    margin: 0;
  }

  .hero-info h2 {
    color: #444;
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
    margin: 0;
  }

  .location {
    color: #666;
    font-size: 0.85rem;
  }

  .hero-image img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    border-radius: 16px;
  }

  .contact-links {
    display: flex;
    gap: 4px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .contact-links {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  .contact-item {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .contact-item:hover {
    background: #eee;
    border: 1px solid #ddd;
  }

  /* Hide contact text on screen, show only icons */
  .contact-text {
    display: none;
  }

  /* Location icon styling */
  .location {
    color: #666;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
  }

  /* Timeline styles */
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-list article h3 {
    font-weight: 600;
    color: #111;
    margin: 0;
  }

  .timeline-list article h4 {
    color: #333;
    font-weight: 500;
    margin: 4px 0;
  }

  .timeline-list article p {
    margin: 0;
  }

  .timeline-list header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .date-range {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    text-align: right;
  }

  /* Skills styles */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .skill-category h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #111;
    margin-bottom: 0.5rem;
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .keyword {
    background: #f5f5f5;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #555;
    border: 1px solid #e0e0e0;
  }

  @media print {
    main {
      padding: 0 !important;
      margin: 0 !important;
    }

    section {
      margin-bottom: 8pt;
    }

    .hero-container {
      gap: 0.5rem;
      margin-bottom: 6pt;
    }

    .hero-info {
      padding-right: 0;
      gap: 0.25rem;
    }

    .hero-info h1 {
      font-size: 16pt;
      margin-bottom: 2pt;
    }

    .hero-info h2 {
      font-size: 11pt;
      margin-bottom: 2pt;
    }

    .location {
      font-size: 9pt;
    }

    /* Hide location icon in print */
    .location :global(svg) {
      display: none;
    }

    .hero-image img {
      width: 80px;
      height: 80px;
      border-radius: 8px;
    }

    .contact-links {
      display: flex;
      flex-wrap: wrap;
      margin-top: 4pt;
      gap: 0;
      max-width: 100%;
    }

    .contact-item {
      display: inline-block;
      width: auto !important;
      height: auto !important;
      padding: 0 !important;
      margin: 0 !important;
      border: none !important;
      background: none !important;
      font-size: 8.5pt;
      color: #000;
      text-decoration: none;
      white-space: nowrap;
    }

    .contact-item:not(:last-child)::after {
      content: " • ";
      color: #666;
      margin: 0 3pt;
    }

    /* Hide icons in print */
    .contact-item :global(svg) {
      display: none;
    }

    /* Show contact text in print mode */
    .contact-text {
      display: inline !important;
      font-size: 8.5pt;
      color: #000;
    }

    .timeline-list {
      gap: 6pt !important;
    }

    .timeline-list article {
      page-break-inside: avoid;
    }

    .timeline-list article h3 {
      font-size: 10pt;
      margin-bottom: 1pt;
    }

    .timeline-list article h4 {
      font-size: 9pt;
      margin-bottom: 1pt;
    }

    .timeline-list article p {
      font-size: 8.5pt;
      line-height: 1.3;
      margin-bottom: 0;
    }

    .timeline-list header {
      margin-bottom: 2pt;
    }

    .date-range {
      font-size: 8pt;
    }

    .skills-list {
      gap: 6pt !important;
    }

    .skill-category h3 {
      font-size: 10pt;
      margin-bottom: 2pt;
    }

    .keywords {
      gap: 3pt !important;
    }

    .keyword {
      background: transparent;
      border: 0.5pt solid #ccc;
      padding: 1pt 4pt;
      font-size: 8pt;
      border-radius: 2px;
    }
  }
</style>
