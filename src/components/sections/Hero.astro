---
import {basics} from '../../cv.json'
import Section from '../Section.astro'

import Mail from '../../icons/Mail.astro'
import Phone from '../../icons/Phone.astro'
import GitHub from '../../icons/GitHub.astro'
import LinkedIn from '../../icons/LinkedIn.astro'
import WorldMap from 'src/icons/WorldMap.astro'





const {name, label, image, location, profiles, phone, email} = basics
const {city, region} = location
const SOCIAL_ICONS: Record<string, any> = {
    GitHub,
    LinkedIn
}

---

<Section>
    <div class="container">
        <div class="info">
            <h1>{name}</h1>
            <h2>{label}</h2>
            <span>
                <WorldMap />
                {city}, {region}
            </span>
            <footer class="contact-links">
                {
                    email &&
                    <a
                        href={`mailto:${email}`}
                        title={`Send email to ${name} at ${email}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-item"
                    >
                        <Mail />
                        <span class="contact-text">{email}</span>
                    </a>
                }
                {
                    phone &&
                    <a
                        href={`tel:${phone}`}
                        title={`Call ${name} at ${phone}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-item"
                    >
                        <Phone />
                        <span class="contact-text">{phone}</span>
                    </a>
                }
                {
                    profiles.map( ({ network, url, username }) => {
                        const Icon = SOCIAL_ICONS[network]
                        return (
                            <a
                                href={url}
                                title={`Visit ${name}'s ${network} profile`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="contact-item"
                            >
                                <Icon />
                                <span class="contact-text">{network}: {username || url}</span>
                            </a>
                        )
                    })
                }
            </footer>
        </div>
        <figure>
            <img src={image} alt={name} />
        </figure>

        

    </div>
</Section>


<style>
    .container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-right: 32px;
    }

    h1 {
        font-size: 2rem;
    }

    h2 {
        color: #444;
        font-weight: 500;
        font-size: 1.1rem;
        text-wrap: balance;
    }

    img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        width: 128px;
        border-radius: 16px;
    }

    span {
        color: #666;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.85rem;

    }

    footer {
        display: flex;
        gap: 4px;
        margin-top: 8px;
    }

    footer a {
        color: #777;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #eee;
        padding: 4px;
        height: 32px;
        width: 32px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    footer a:hover {
        background: #eee;
        border: 1px solid #ddd;
    }

    /* Hide contact text on screen, show only icons */
    .contact-text {
        display: none;
    }

    @media print {
        .container {
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .info {
            padding-right: 0;
            gap: 0.25rem;
        }

        h1 {
            font-size: 16pt;
            margin-bottom: 2pt;
        }

        h2 {
            font-size: 11pt;
            margin-bottom: 2pt;
            color: #333;
        }

        /* Profile image - larger for better appearance */
        img {
            width: 80px;
            height: 80px;
            border-radius: 8px;
        }

        /* Compact location */
        span {
            font-size: 9pt;
        }

        /* Hide location icon */
        span :global(svg) {
            display: none;
        }

        /* Print contact info as text - fix overlap */
        .contact-links {
            display: flex;
            flex-wrap: wrap;
            margin-top: 4pt;
            gap: 0;
            max-width: 100%;
        }

        .contact-item {
            display: inline-block;
            width: auto !important;
            height: auto !important;
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            background: none !important;
            color: #000;
            text-decoration: none;
            white-space: nowrap;
        }

        .contact-item:not(:last-child)::after {
            content: " • ";
            color: #666;
            margin: 0 3pt;
        }

        /* Hide icons, show text */
        .contact-item :global(svg) {
            display: none;
        }

        .contact-text {
            display: inline !important;
            font-size: 8.5pt;
            color: #000;
        }
    }
</style>
