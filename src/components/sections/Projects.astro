---
import Section from '../Section.astro'
import { projects } from '../../cv.json'
---

{projects && projects.length > 0 && (
    <Section title="Projects">
        <ul class="projects-list">
            {projects.map(({name, description, highlights, url, startDate, endDate}) => {
                const startYear = startDate ? new Date(startDate).getFullYear() : '';
                const endYear = endDate ? new Date(endDate).getFullYear() : 'Present';

                return (
                    <li>
                        <article>
                            <header>
                                <div>
                                    {url ? (
                                        <a href={url} target="_blank" rel="noopener noreferrer">
                                            <h3>{name}</h3>
                                        </a>
                                    ) : (
                                        <h3>{name}</h3>
                                    )}
                                </div>
                                {startDate && (
                                    <div class="date-range">
                                        <time datetime={startDate}>{startYear}</time>
                                        {' - '}
                                        <time datetime={endDate}>{endYear}</time>
                                    </div>
                                )}
                            </header>
                            {description && <p>{description}</p>}
                            {highlights && highlights.length > 0 && (
                                <ul class="highlights">
                                    {highlights.map((highlight) => (
                                        <li>{highlight}</li>
                                    ))}
                                </ul>
                            )}
                        </article>
                    </li>
                );
            })}
        </ul>
    </Section>
)}

<style>
    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 600;
        color: #111;
    }

    article a {
        color: #0066cc;
        text-decoration: none;
    }

    article a:hover {
        text-decoration: underline;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    .date-range {
        color: #555;
        font-size: 0.85rem;
        min-width: 102px;
    }

    .highlights {
        margin-top: 8px;
        padding-left: 1.5rem;
        list-style: disc;
    }

    .highlights li {
        color: #666;
        font-size: 0.9rem;
    }

    @media print {
        .projects-list {
            gap: 0.5rem;
        }

        article h3 {
            font-size: 10pt;
        }

        article a {
            color: #000;
        }

        .date-range {
            font-size: 8pt;
        }

        .highlights {
            margin-top: 4pt;
        }

        .highlights li {
            font-size: 8pt;
        }
    }
</style>