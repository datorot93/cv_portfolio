---
import Section from '../Section.astro'
import { work } from '../../cv.json'
---

{work && work.length > 0 && (
<Section title="Work Experience">
    <ul class="timeline-list">
        {
            work.map(
                ({name, position, url, startDate, endDate, summary, highlights}) => {
                    const startMonthName = new Intl.DateTimeFormat(
                        "en-US", {month: "long"}
                    ).format((new Date(startDate)))

                    const startYear = new Date(startDate).getFullYear()

                    const endYear =
                        endDate != null ? new Date(endDate).getFullYear() : "Current"

                    const endMonthName =
                        endDate != null ? new Intl.DateTimeFormat(
                            "en-US", {month: "long"}
                        ).format(new Date(endDate)) : "Current"

                    return (
                        <li>
                            <article class="experience-item">
                                <header>
                                    <div>
                                        <h3>{name}</h3>
                                        <h4>{position}</h4>
                                    </div>
                                    <div class="date-range">
                                        <time
                                            datetime={startDate}
                                            data-title={startDate}
                                        >
                                            {`${startMonthName}/${startYear}`}
                                        </time>
                                        {' - '}
                                        <time
                                            datetime={endDate}
                                            data-title={endDate}
                                        >
                                            {
                                                endDate != null
                                                    ? `${endMonthName}/${endYear}`
                                                    : 'Present'
                                            }
                                        </time>
                                        <button class="expand-toggle" aria-expanded="false" type="button">
                                            <span class="sr-only">Show description</span>
                                            <span class="arrow" aria-hidden="true">▼</span>
                                        </button>
                                    </div>
                                </header>

                                <div class="description" data-collapsed="true">
                                    <p>{summary}</p>
                                </div>
                            </article>
                        </li>
                    )
                }
            )
        }
    </ul>
</Section>
)}

