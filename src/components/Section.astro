
---
const { title } = Astro.props
---


<section>
    {title && <h2>{title}</h2>}
    <slot />
</section>


<style>
    section{
        max-width: 700px;
        margin: 0 auto 48px;
    }

    h2 {
        margin-bottom: 8px;
        font-weight: 700;
        line-height: 1.5;
        font-size: 1.5rem;
    }

    @media print {
        section {
            max-width: 100%;
            margin: 0 0 8pt 0;
            page-break-inside: avoid;
        }

        h2 {
            font-size: 11pt;
            margin-bottom: 4pt;
            font-weight: 600;
            border-bottom: 0.5pt solid #ccc;
            padding-bottom: 2pt;
        }
    }
</style>